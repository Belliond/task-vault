# Isi dengan token bot Telegram kamu (dari @BotFather)
TELEGRAM_BOT_TOKEN=

# Chat ID kamu. Kirim /start ke @userinfobot untuk tahu angkanya.
TELEGRAM_CHAT_ID=

# Nama yang dipakai bot saat menyapa
WA_BRIDGE_NAMA=Krisna

# Teruskan pesan WhatsApp masuk ke Telegram (1 = ya, 0 = tidak)
WA_BRIDGE_KE_TG=1

# Terima perintah dari Telegram untuk mengirim WhatsApp (1 = ya)
WA_BRIDGE_KE_WA=1

# Jangan teruskan pesan yang kamu kirim sendiri dari HP
WA_BRIDGE_ABAIKAN_DIRI=1

# Opsional: nomor tujuan default. Kalau diisi, pesan Telegram
# tanpa /to langsung dikirim ke nomor ini. Notifikasi tugas
# juga selalu dikirim ke nomor ini.
WA_BRIDGE_TUJUAN=

# Antrean notifikasi tugas (dari GitHub Actions).
# SUPABASE_KEY di sini kunci publishable -- memang publik di
# halaman web, jadi aman. Tujuan kirim tetap dari
# WA_BRIDGE_TUJUAN di atas, bukan dari isi tabel antrean.
SUPABASE_URL=
SUPABASE_KEY=

# Jeda antar-pemeriksaan antrean, milidetik. Default 15000.
WA_BRIDGE_ANTREAN_JEDA_MS=15000

# Nomor WhatsApp yang mau dihubungkan, tanpa + dan tanpa 0 di depan.
# Kalau diisi, kamu TIDAK perlu scan QR — cukup ketik kode 8 digit
# yang muncul di terminal. Ini jalur termudah kalau jembatan jalan
# di HP yang sama dengan WhatsApp-nya.
# Contoh: 628123456789
WA_BRIDGE_PASANGAN=
