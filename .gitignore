# =========================================================
#  KREDENSIAL — JANGAN PERNAH DI-COMMIT
# =========================================================
#  .env        : nilai asli yang Anda isi
#  config.js   : hasil generate dari .env (dibaca browser)
#
#  Keduanya berisi kredensial. Yang di-commit hanya
#  .env.example (template tanpa nilai rahasia).
# =========================================================

.env
.env.*
!.env.example
config.js


# Dependency
node_modules/


# =========================================================
#  SESI WHATSAPP — SANGAT RAHASIA
# =========================================================
#  Folder auth/ dan auth-laptop/ berisi kunci akun WhatsApp.
#  Siapa pun yang memegang file ini bisa menyamar sebagai
#  pemilik nomor tanpa perlu kode pairing. JANGAN PERNAH
#  di-commit, jangan diunggah, jangan dikirim lewat chat.
# =========================================================

auth/
auth-laptop/
auth-laptop.tar.gz
qr-laptop.png
auth*.tar.gz

# Supabase CLI state
supabase/.temp/
supabase/.branches/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Log
*.log

# File uji sementara
tmp-*
