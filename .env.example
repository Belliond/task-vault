# =========================================================
#  KONFIGURASI LOKAL — SALIN FILE INI MENJADI .env
# =========================================================
#
#  cp .env.example .env      (Windows: copy .env.example .env)
#
#  File .env TIDAK ikut ter-commit (lihat .gitignore) karena
#  berisi kredensial. Jangan pernah commit .env.
#
#  Setelah mengubah .env, jalankan:
#      npm run env:build
#  File config.js akan dibuat ulang dari nilai di sini.
#
#  CATATAN PENTING SOAL RAHASIA
#  Semua nilai di file ini berakhir di browser dan bisa
#  dibaca siapa pun yang membuka web. Jadi:
#    - Pakai HANYA publishable / anon key, JANGAN service_role.
#    - Jangan taruh password, secret key, atau token pribadi.
#  Yang benar-benar rahasia hanya boleh ada di sisi server.
# =========================================================


# ---------------------------------------------------------
#  SUPABASE
#  Dashboard -> Project Settings -> API
#  Project URL bentuknya: https://<REF>.supabase.co
#
#  Isi dua baris di bawah dengan milik proyek Anda.
# ---------------------------------------------------------

SUPABASE_URL=

# Publishable key (dulu disebut "anon key"). Aman di browser
# SELAMA Row Level Security mengatur aksesnya. Di proyek ini
# RLS memang dimatikan secara sadar (mode kelas bersama),
# jadi siapa pun dengan key ini bisa menulis ke tabel.
#
# JANGAN isi dengan service_role / sb_secret_... — kunci itu
# memberi akses penuh dan akan ditolak oleh generator.
SUPABASE_KEY=


# ---------------------------------------------------------
#  DATABASE (KHUSUS MIGRASI — TIDAK DIBACA BROWSER)
#
#  Hanya dipakai oleh `npm run db:push` untuk membuat tabel,
#  kolom, dan fungsi. Tidak pernah masuk ke config.js.
#
#  Isi dengan password database:
#    Dashboard -> Project Settings -> Database
#    -> Reset database password (kalau lupa)
#
#  Kalau baris ini kosong, `npm run db:push` akan berhenti
#  dan memberi instruksi. Aplikasi web tetap jalan normal.
#
#  PERINGATAN: password ini memberi akses penuh ke database.
#  File .env tidak ikut ter-commit, tapi tetap jangan
#  dibagikan. Ganti password setelah selesai kalau perlu.
# ---------------------------------------------------------

SUPABASE_DB_PASSWORD=

# Opsional - BIARKAN KOSONG.
# Script sudah mencari server database otomatis. Isi hanya
# kalau pencarian otomatis gagal.
#
# Ambil di: Dashboard -> tombol "Connect" -> tab "Session pooler"
# Bentuknya HARUS diawali postgresql:// (bukan https://):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Ganti <password> sendiri; dashboard hanya menampilkan
# [YOUR-PASSWORD] sebagai placeholder.
SUPABASE_DB_URL=


# ---------------------------------------------------------
#  MOODLE (LMS KAMPUS)
#  Dipakai sebagai nilai awal kolom "SITE URL" di panel
#  Sync LMS. User tetap bisa mengubahnya di UI.
# ---------------------------------------------------------

MOODLE_URL=https://kuliah2.itera.ac.id

# Token web service milik user — dipakai HANYA oleh
# `npm run sync` dan .github/workflows/sync.yml.
#
# Ambil di: https://kuliah2.itera.ac.id/user/managetoken.php
# (login dulu, lalu salin token service "moodle_mobile_app").
#
# PERINGATAN: token ini setara password untuk API Moodle.
# Ia TIDAK masuk config.js (generator mengabaikannya), jadi
# tidak pernah sampai ke browser. Untuk sync otomatis,
# simpan di GitHub Secrets, bukan di sini.
MOODLE_TOKEN=

# Opsional. Batasi mata kuliah yang disinkronkan, dipisah
# koma. Kosong = semua mata kuliah yang diikuti.
# Contoh: 968,970
MOODLE_COURSE_IDS=


# ---------------------------------------------------------
#  GOOGLE CLASSROOM
#
#  Client ID OAuth milik Anda sendiri (bukan rahasia).
#  Kalau diisi, kolom Client ID di UI otomatis terisi dan
#  user tidak perlu menempelkannya manual.
#
#  Kosongkan kalau belum punya. Format:
#  <angka>-<acak>.apps.googleusercontent.com
# ---------------------------------------------------------

CLASSROOM_CLIENT_ID=

# Redirect URI yang didaftarkan di Google Cloud Console.
# Kosongkan untuk memakai otomatis origin + path halaman
# (mis. https://belliond.github.io/task-vault/).
# Isi hanya kalau redirect-nya berbeda dari halaman itu.
CLASSROOM_REDIRECT=

# ---------------------------------------------------------
#  GOOGLE CLASSROOM - SYNC OTOMATIS
#
#  Tiga nilai di bawah dipakai `npm run sync` dan
#  .github/workflows/sync.yml, BUKAN oleh browser. Tidak
#  masuk config.js.
#
#  PENTING: client untuk sync HARUS berbeda dari client
#  milik situs (CLASSROOM_CLIENT_ID di atas).
#
#  Client situs bertipe "Web application" dengan redirect
#  https. Tipe itu MENOLAK redirect http://127.0.0.1
#  (diuji: redirect_uri_mismatch), sehingga tidak bisa
#  dipakai mengambil refresh token.
#
#  Cara mengisinya:
#    1. Buat OAuth client KEDUA tipe "Desktop app" di
#       https://console.cloud.google.com/auth/clients
#    2. Isi CLASSROOM_SYNC_CLIENT_ID dan
#       CLASSROOM_SYNC_CLIENT_SECRET
#    3. Jalankan: npm run classroom:auth
#    4. Tempel CLASSROOM_SYNC_REFRESH_TOKEN yang dicetak
#
#  PERINGATAN: refresh token ini setara password untuk akun
#  Classroom Anda. Untuk sync otomatis, simpan di GitHub
#  Secrets, bukan hanya di sini.
# ---------------------------------------------------------

CLASSROOM_SYNC_CLIENT_ID=
CLASSROOM_SYNC_CLIENT_SECRET=
CLASSROOM_SYNC_REFRESH_TOKEN=
